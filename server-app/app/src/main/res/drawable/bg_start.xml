<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#FF142010" />
            <stroke android:width="1dp" android:color="@color/green_dark" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/green_bright" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#FF5E9400" android:endColor="@color/green" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
